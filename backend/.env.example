# Backend Environment Variables
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (MongoDB connection string or leave empty for auto local fallback)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=syntra_db

# Authentication
JWT_SECRET=syntra_super_secret_jwt_key_9837428934729384792384792
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (OpenAI, Groq, Ollama, etc. or Demo Mode)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Embedding Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads
DEMO_MODE=true
